# URL base de la API. Déjala vacía para usar el proxy local de Vite o el Rewrite /api/* de Render.
# Si publicas la API directamente en otro origen, pon aquí su URL y permite el origen del frontend
# en CORS_ALLOWED_ORIGINS del backend.
VITE_API_BASE_URL=

# Solo desarrollo: destino del proxy /api de Vite.
VITE_DEV_PROXY_TARGET=http://localhost:8081

# Credenciales temporales de desarrollo. Nunca uses estas variables ni estas contraseñas en producción.
VITE_ADMIN_EMAIL=admin@motoboutique.local
VITE_ALMACENERO_EMAIL=almacenero@motoboutique.local
VITE_CONTADOR_EMAIL=contador@motoboutique.local
VITE_CONSULTA_EMAIL=consulta@motoboutique.local
VITE_ADMIN_PASSWORD=admin123
VITE_DEMO_PASSWORD=user1123
