# Conexión PostgreSQL local
# Para Supabase usa el host de Transaction Pooler o Session Pooler y DB_USER=postgres.<project-ref>.
DB_HOST=localhost
# Usa 5432 (session pooler o conexión directa). El puerto 6543 (transaction pooler) no es válido para Flyway/JPA.
DB_PORT=5432
DB_NAME=motoboutique
DB_USER=postgres
DB_PASSWORD=

# Credenciales del administrador inicial (pon una contraseña propia de 8 caracteres o más)
ADMIN_EMAIL=admin@motoboutique.local
ADMIN_PASSWORD=

# Contraseña común de los usuarios demo (solo perfil dev). Si queda vacía, no se crean.
ALMACENERO_EMAIL=almacenero@motoboutique.local
CONTADOR_EMAIL=contador@motoboutique.local
CONSULTA_EMAIL=consulta@motoboutique.local
DEMO_PASSWORD=

# Correo SMTP para recuperación de contraseña en producción
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
FRONTEND_URL=http://localhost:5173

# Orígenes del frontend autorizados (CORS), separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Solo perfil prod: SameSite de la cookie de sesión
# Usa lax si frontend/API comparten sitio; usa none con dominios cruzados y HTTPS.
# SESSION_COOKIE_SAME_SITE=lax
